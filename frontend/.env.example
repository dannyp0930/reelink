# Optional: copy to frontend/.env.local if the Backend URL differs from this default.
# Server-side /api proxy target, NOT the Frontend browser URL (3000 or 3002).
# No trailing slash. Restart Frontend after edits; rebuild for production changes.
# Google/TMDB credentials belong in backend/.env, never in NEXT_PUBLIC_ variables.
BACKEND_URL=http://127.0.0.1:3001
