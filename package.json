{
  "name": "reelink",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @reelink/frontend --filter @reelink/backend dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": "pnpm --dir frontend exec eslint --fix"
  },
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
