# Copy to backend/.env (not the repository root). Restart Backend after edits.
# Keep credentials server-only; never commit .env or use NEXT_PUBLIC_ for secrets.
# Backend API port; independent of the Frontend dev-server port.
PORT=3001
# Local development database. Replace credentials for non-local environments.
DATABASE_URL=postgresql://reelink:reelink@localhost:5432/reelink?schema=public
# Frontend origin, without a path. For dev --port 3002, use http://localhost:3002.
APP_ORIGIN=http://localhost:3000
# Google Cloud: Web application; redirect URI = APP_ORIGIN/api/auth/google/callback
# Register the exact URI, including the port. For 3002:
# http://localhost:3002/api/auth/google/callback
# Both values are required for Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TMDB API Read Access Token; server-only raw token without the Bearer prefix.
# Use the Read Access Token, not the v3 API key. Required for movie search/selection.
TMDB_READ_ACCESS_TOKEN=
# Isolated local test database only; never point tests at personal/production data.
# Create reelink_test and apply migrations before running Backend E2E tests.
TEST_DATABASE_URL=postgresql://reelink:reelink@localhost:5432/reelink_test?schema=public
